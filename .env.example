# ==================================================================================================
# Perfana deployment configuration
# --------------------------------------------------------------------------------------------------
# Copy this file to ".env" and fill in every value. ".env" is git-ignored and
# holds secrets, so it must never be committed.
#
#   cp .env.example .env
#
# After editing secrets, regenerate them with strong random values. See INSTALL.md.
# ==================================================================================================

# --------------------------------------------------------------------------------------------------
# ACCESS HOST / SCHEME
# --------------------------------------------------------------------------------------------------
# This deployment is accessed on the server itself over http://localhost, so
# leave these at their defaults. (If you ever expose it under a real hostname
# behind a TLS reverse proxy, set PERFANA_HOST to that name and PERFANA_SCHEME
# to https; bootstrap.sh then aligns the Keycloak client redirect URIs.)
PERFANA_HOST=localhost
PERFANA_SCHEME=http

# --------------------------------------------------------------------------------------------------
# HOST PORTS
# --------------------------------------------------------------------------------------------------
# Ports published on the host for the browser-facing services. Change these if
# the defaults clash with something already running on the host. The browser
# URLs are built from these (Keycloak redirect URIs are aligned by bootstrap.sh),
# so editing here is enough. The API (3001) and Keycloak (8080) ports are fixed.
PERFANA_WEB_PORT=4001
GRAFANA_PORT=3100

# --------------------------------------------------------------------------------------------------
# ADMIN LOG VIEWER
# --------------------------------------------------------------------------------------------------
# The admin log viewer streams container logs through docker-socket-proxy (a
# hardened, read-only Docker Engine API gateway — see docker-compose.yml).
#
# COMPOSE_PROJECT_NAME sets this stack's compose project name (Docker Compose
# reads it natively). perfana-api filters the log viewer's container list by it,
# so keep it stable — renaming it hides the running containers from the viewer.
COMPOSE_PROJECT_NAME=perfana

# --------------------------------------------------------------------------------------------------
# DATABASE
# --------------------------------------------------------------------------------------------------
# PostgreSQL password for the "perfana" user (also used by the Keycloak DB).
# Generate, e.g.:  openssl rand -base64 24
POSTGRES_PASSWORD=change-me-postgres

# --------------------------------------------------------------------------------------------------
# KEYCLOAK
# --------------------------------------------------------------------------------------------------
# Keycloak master-realm admin (the Keycloak console at :8080).
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin

# Confidential client secrets for the perfana-api and perfana-admin clients.
# These MUST match the secrets stored in the imported realm
# (keycloak/realms/perfana-realm.json). The bootstrap script can rotate them.
# Generate, e.g.:  openssl rand -hex 32
KEYCLOAK_CLIENT_SECRET=change-me-perfana-api-secret
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me-perfana-admin-secret

# --------------------------------------------------------------------------------------------------
# ENCRYPTION
# --------------------------------------------------------------------------------------------------
# Symmetric key used by perfana-api / -worker / -grafana-sync / -report to
# encrypt stored credentials (Grafana tokens, datasource passwords, etc.).
# MUST be a 64-character hex string and MUST stay stable for the life of the
# deployment (changing it makes previously stored secrets unreadable).
# Generate:  openssl rand -hex 32
ENCRYPTION_KEY=change-me-64-hex-characters-0000000000000000000000000000000000

# --------------------------------------------------------------------------------------------------
# GRAFANA
# --------------------------------------------------------------------------------------------------
# Local Grafana admin account (used by the bootstrap script to create a service
# account token, and as a break-glass login).
GRAFANA_ADMIN_USER=perfana
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin

# Secret for the "grafana" OAuth client in Keycloak. MUST match the realm.
GRAFANA_OAUTH_CLIENT_SECRET=change-me-grafana-oauth-secret

# --------------------------------------------------------------------------------------------------
# GRAFANA ALERTING
# --------------------------------------------------------------------------------------------------
# Grafana provisions only Perfana's own TimescaleDB data source. Add any other
# data sources (Prometheus/Loki/Tempo/etc.) from the Grafana UI as needed.
#
# Where Grafana managed alerts are POSTed. Defaults to the Perfana API. Only
# change if Perfana's alert webhook lives elsewhere in your environment.
PERFANA_ALERTS_WEBHOOK_URL=http://perfana-api:3001/api/grafana-alerts

# --------------------------------------------------------------------------------------------------
# FIRST-RUN BOOTSTRAP (used by bootstrap.sh only)
# --------------------------------------------------------------------------------------------------
# Initial Perfana organization and the admin user that bootstrap.sh promotes to
# org-admin. PERFANA_ADMIN_USER must be a username that exists in the realm
# (the shipped realm contains admin@perfana.io). PERFANA_ADMIN_PASSWORD is set
# on that user by the bootstrap script — choose a strong value.
PERFANA_ORG_NAME=Perfana
PERFANA_ADMIN_USER=admin@perfana.io
PERFANA_ADMIN_PASSWORD=change-me-perfana-admin-login
