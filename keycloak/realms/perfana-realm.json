        "composite": false,
        "clientRole": false,
        "containerId": "perfana-prod",
        "attributes": {}
      },
      {
        "name": "perfana-admin",
        "description": "Perfana administrator role",
        "composite": true,
        "composites": {
          "realm": [
            "perfana-user"
          ]
        },
        "clientRole": false,
        "containerId": "perfana-prod",
        "attributes": {}
      },
      {
        "name": "perfana-viewer",
