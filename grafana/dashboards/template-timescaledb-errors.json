          "format": "table",
          "hide": false,
          "rawQuery": true,
          "rawSql": "SELECT\n  time as \"Time\",\n  sampler_name as \"Sampler\",\n  transaction_name as \"Transaction\",\n  url,\n  response_code as \"Code\",\n  response_message as \"Message\",\n  response_time as \"RT\",\n  node_name as \"Node\",\n  assertions as \"Assertions\"\nFROM requests_error$table_suffix\nWHERE \n    floor(extract(epoch from time) * 1000)=$timestamp AND\n    random_id=${randomId}",
