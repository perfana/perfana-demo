          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres-timescaledb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH s AS (\n  SELECT ts, metric, source, value,\n    GREATEST(value - LAG(value) OVER (PARTITION BY metric, source ORDER BY ts), 0)\n    / GREATEST(EXTRACT(EPOCH FROM (ts - LAG(ts) OVER (PARTITION BY metric, source ORDER BY ts))), 1) AS rate\n  FROM monitoring.pg_samples\n  WHERE metric LIKE 'docker.%' AND $__timeFilter(ts)\n)\nSELECT\n  source AS \"Container\",\n  avg(rate) FILTER (WHERE metric = 'docker.cpu.usage_ns') / 1e9   AS \"CPU cores avg\",\n  max(rate) FILTER (WHERE metric = 'docker.cpu.usage_ns') / 1e9   AS \"CPU cores peak\",\n  max(value) FILTER (WHERE metric = 'docker.mem.working_set_bytes') AS \"Memory peak\",\n  100.0 * max(value) FILTER (WHERE metric = 'docker.mem.working_set_bytes')\n        / NULLIF(max(value) FILTER (WHERE metric = 'docker.mem.limit_bytes'), 0) AS \"Memory %\",\n  avg(rate) FILTER (WHERE metric = 'docker.blkio.read_bytes')  AS \"Block read/s\",\n  avg(rate) FILTER (WHERE metric = 'docker.blkio.write_bytes') AS \"Block write/s\",\n  avg(rate) FILTER (WHERE metric = 'docker.net.rx_bytes')      AS \"Net rx/s\",\n  avg(rate) FILTER (WHERE metric = 'docker.net.tx_bytes')      AS \"Net tx/s\",\n  max(value) FILTER (WHERE metric = 'docker.pids.current')     AS \"PIDs peak\"\nFROM s\nGROUP BY 1\nORDER BY 2 DESC NULLS LAST;",
          "refId": "A"
        }
      ],
      "title": "Containers in this range",
      "type": "table"
    },
