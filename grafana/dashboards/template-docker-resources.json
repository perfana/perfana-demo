    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres-timescaledb"
      },
      "description": "Container CPU time consumed per wall-clock second: 1.0 means one core saturated. Compare against \"Host cores\" — the whole stack summed against that number is the real ceiling.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 40,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "mappings": [],
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 10,
        "x": 0,
        "y": 13
      },
      "id": 4,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres-timescaledb"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  time_bucket('$__interval', ts) AS time,\n  source AS container,\n  avg(rate) / 1e9 AS \"cores\"\nFROM (\n  SELECT ts, metric, source,\n    GREATEST(value - LAG(value) OVER (PARTITION BY metric, source ORDER BY ts), 0)\n    / GREATEST(EXTRACT(EPOCH FROM (ts - LAG(ts) OVER (PARTITION BY metric, source ORDER BY ts))), 1) AS rate\n  FROM monitoring.pg_samples\n  WHERE metric = 'docker.cpu.usage_ns' AND $__timeFilter(ts)\n) r\nWHERE rate IS NOT NULL\nGROUP BY 1, 2\nORDER BY 1, 2;",
          "refId": "A"
        }
      ],
      "title": "CPU cores used",
      "type": "timeseries"
    },
    {
      "datasource": {
