      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres-timescaledb"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  time_bucket('$__interval', ts) AS time,\n  source AS container,\n  100.0 * sum(d) FILTER (WHERE metric = 'docker.cpu.throttled_periods')\n        / NULLIF(sum(d) FILTER (WHERE metric = 'docker.cpu.periods'), 0) AS \"throttled %\"\nFROM (\n  SELECT ts, metric, source,\n    GREATEST(value - LAG(value) OVER (PARTITION BY metric, source ORDER BY ts), 0) AS d\n  FROM monitoring.pg_samples\n  WHERE metric IN ('docker.cpu.throttled_periods', 'docker.cpu.periods')\n    AND $__timeFilter(ts)\n) x\nWHERE d IS NOT NULL\nGROUP BY 1, 2\nHAVING sum(d) FILTER (WHERE metric = 'docker.cpu.throttled_periods') > 0\nORDER BY 1, 2;",
          "refId": "A"
        }
      ],
      "title": "CPU throttled",
      "type": "timeseries"
    },
